# === 加密货币监控系统配置 ===
# 复制此文件为 .env 并填入实际值

# 服务端配置
GCP_IP=your_gcp_ip_address
GEMINI_API_KEY=your_gemini_api_key

# Telegram 配置
TG_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id

# 可选配置
LOG_LEVEL=INFO
DATABASE_PATH=./data/crypto_monitor.db
ONCHAIN_WEBHOOK_TOKEN=
ONCHAIN_WEBHOOK_SECRET=
SERVICE_ADMIN_TOKEN=
DEXSCREENER_BASE_URL=
AFFILIATE_REFERRAL_CODE=
AFFILIATE_DEEP_LINK_TEMPLATE=
